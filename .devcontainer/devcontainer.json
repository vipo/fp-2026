{
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers-contrib/features/apt-packages:1": {
      "packages": ["build-essential", "curl", "libffi-dev", "libgmp-dev", "libncurses-dev", "zlib1g-dev", "pkg-config"]
    }
  },
	"customizations": {
		"vscode": {
			"extensions": [
				"haskell.haskell",
				"justusadam.language-haskell"
			]
		}
	},
	"containerEnv": {
		"LC_ALL": "en_US.UTF-8",
		"GHC_CHARENC": "GHC_NO_UNICODE"
	}
}
