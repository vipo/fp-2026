cabal-version:      3.0
name:               fp2026
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             ViPo
maintainer:         pi@homedir.eu
build-type:         Simple
extra-doc-files:    CHANGELOG.md

library
    ghc-options:        -Wall
                        -Wno-type-defaults
    exposed-modules:    Lessons.Lesson01
                        Lessons.Lesson02
                        Lessons.Lesson03
                        Lessons.Lesson04
                        Lessons.Lesson05
                        Lessons.Lesson06
                        Lessons.Lesson07
                        Lessons.Lesson08
                        Lessons.Lesson09
    build-depends:      base ^>=4.20.2.0
    hs-source-dirs:     src
    default-language:   Haskell2010

executable fp2026
    main-is:            Main.hs
    other-modules:    
    build-depends:      base ^>=4.20.2.0
    hs-source-dirs:     app
    ghc-options:        -threaded -rtsopts -with-rtsopts=-N
    default-language:   Haskell2010
